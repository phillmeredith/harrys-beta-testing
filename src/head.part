<title>Harry's Mod</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Silkscreen:wght@400;700&family=VT323&family=Jersey+15&display=swap">
<style>
/* Layout: blocky game-menu look. Dirt-tile backdrop (drawn at runtime), stone bevelled buttons, light-grey inventory panels, pixel type. One deliberate dark look in every theme. */
:root{
  --bg:#2B1F16; --ink:#FFFFFF; --muted:#C8C8C8; --shade:#3F3F3F;
  --stone:#7A7A7A; --stone-hi:#ABABAB; --stone-lo:#4A4A4A;
  --panel:#C6C6C6; --panel-hi:#FFFFFF; --panel-lo:#555555; --panel-ink:#3F3F3F;
  --broken:#A8332B; --better:#B8860B; --idea:#2E5FA8; --ok:#3F8E2E; --gold:#FFFF55;
  --line:#000000; --card:#C6C6C6; --bg2:#8B8B8B; --leather:#8A4B2A;
  --pix:"Pixelify Sans","VT323","Courier New",monospace;
  --head:"Jersey 15","Pixelify Sans",monospace;
  --mono:"VT323","Courier New",monospace;
  --display:var(--pix); --body:var(--pix);
  color-scheme:dark;
}
html,body{height:100%}
body{color:var(--ink);font-family:var(--pix);font-size:20px;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
.app{max-width:1120px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;gap:26px;padding-block:22px 40px}
.txt{text-shadow:3px 3px 0 var(--shade)}

/* stone button: black outline, light top-left bevel, dark bottom-right bevel */
.mcbtn,.tile,.go,.round,.grown{position:relative;font-family:var(--pix);color:#fff;text-shadow:2px 2px 0 var(--shade);cursor:pointer;border:3px solid var(--line);border-radius:0;
  background:var(--stone);box-shadow:inset 3px 3px 0 var(--stone-hi),inset -3px -4px 0 var(--stone-lo)}
.tile:hover,.go:hover,.round:hover,.grown:hover{outline:3px solid #fff;outline-offset:-6px}
.tile:active,.go:active,.round:active{box-shadow:inset 3px 3px 0 var(--stone-lo),inset -3px -3px 0 var(--stone-hi)}
:focus-visible{outline:3px solid var(--gold)!important;outline-offset:2px}

.bar{display:flex;align-items:center;gap:12px}
.round{flex:none;width:60px;height:60px;font-size:28px;display:grid;place-items:center;padding:0}
.round[disabled]{visibility:hidden}
.round.on{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A}
.spacer{flex:1}
.grown{font-size:16px;padding:10px 14px;background:#4E4E4E;box-shadow:inset 2px 2px 0 #777,inset -2px -3px 0 #2A2A2A}

.q{display:flex;align-items:center;gap:12px}
.q h1{font:400 clamp(34px,4.6vw,52px)/1.05 var(--head);letter-spacing:.02em;margin:0;text-shadow:3px 3px 0 var(--shade);text-wrap:balance}
.hint{font-size:20px;color:var(--muted);margin:4px 0 0;text-shadow:2px 2px 0 #000}
.say{flex:none;border:none;background:none;font-size:32px;cursor:pointer;padding:6px;color:var(--muted);display:grid}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}
.grid.big{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.tile{min-height:104px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:18px 14px;
  font-size:24px;font-weight:600;line-height:1.15;text-align:center;text-wrap:balance}
.tile small{font-size:17px;font-weight:500;color:#E0E0E0}
.tile.sel{outline:4px solid var(--gold);outline-offset:-8px}
.tile.sel::after{content:"";position:absolute;top:8px;right:8px;width:14px;height:14px;background:var(--gold);box-shadow:2px 2px 0 var(--shade)}
.grid.big .tile{min-height:230px;font-size:38px}
.grid.big .tile small{font-size:20px}
.k-broken{background:var(--broken)!important;box-shadow:inset 3px 3px 0 #D4625A,inset -3px -4px 0 #651D18!important}
.k-better{background:var(--better)!important;box-shadow:inset 3px 3px 0 #E2B23D,inset -3px -4px 0 #6E5006!important}
.k-idea{background:var(--idea)!important;box-shadow:inset 3px 3px 0 #5E8BD4,inset -3px -4px 0 #193966!important}
.tile.horse{min-height:140px}
.horse .coin{width:56px;height:56px;display:grid;place-items:center;font:600 28px var(--pix);color:#fff;border:3px solid #000;
  box-shadow:inset 3px 3px 0 rgba(255,255,255,.35),inset -3px -3px 0 rgba(0,0,0,.35);text-shadow:2px 2px 0 rgba(0,0,0,.7)}
.typetile{background:#4E4E4E!important;box-shadow:inset 2px 2px 0 #777,inset -2px -3px 0 #2A2A2A!important}
.row-label{font:400 34px var(--head);letter-spacing:.02em;margin:8px 0 -10px;text-shadow:3px 3px 0 var(--shade)}

.go{align-self:center;font-size:28px;font-weight:600;padding:16px 46px;min-width:240px}
.go[disabled]{opacity:.45;cursor:default;outline:none}
.go.quiet{background:#4E4E4E;box-shadow:inset 3px 3px 0 #777,inset -3px -4px 0 #2A2A2A}
.go.small{font-size:20px;padding:10px 20px;min-width:0}
.go#send,.go#later,.go#namedone,.go#again,.go#next{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A}

/* inventory panel */
.panel,.story,.editor,.namebox{background:var(--panel);color:var(--panel-ink);border:3px solid var(--line);border-radius:0;text-shadow:none;
  box-shadow:inset 4px 4px 0 var(--panel-hi),inset -4px -4px 0 var(--panel-lo)}
.panel{padding:28px 24px;display:flex;flex-direction:column;gap:16px;align-items:center;text-align:center;min-width:0}
.panel h2{font:400 34px var(--head);margin:0;letter-spacing:.02em}
.extras{display:grid;grid-template-columns:minmax(0,560px);justify-content:center;gap:20px}
.slot{width:100%;max-width:420px;aspect-ratio:4/3;background:#8B8B8B;border:0;box-shadow:inset 3px 3px 0 #373737,inset -3px -3px 0 #fff;display:grid;place-items:center;overflow:hidden;position:relative}
.slot img{width:100%;height:100%;object-fit:cover;display:block;image-rendering:auto}
.slot .empty{color:#3F3F3F;font-size:20px;padding:20px}
.slot .tag{position:absolute;left:8px;bottom:8px;background:rgba(0,0,0,.7);color:#fff;font-size:15px;padding:3px 8px}
.filepick{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}

.namebox{padding:30px;display:flex;flex-direction:column;gap:20px;align-items:center;max-width:720px;width:100%;align-self:center;box-sizing:border-box}
.namebox label{font:600 30px var(--pix)}
.namebox input,#msg{background:#000;color:#fff;border:3px solid #A0A0A0;border-radius:0;user-select:text;-webkit-user-select:text;box-sizing:border-box}
.namebox input{width:100%;font:500 40px var(--pix);text-align:center;padding:14px 18px}
.namebox input:focus,#msg:focus{outline:none;border-color:#fff}
.namebox .note{color:var(--panel-ink)}

.story{padding:26px 30px;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.story p{font:600 clamp(26px,3vw,34px)/1.25 var(--pix);margin:0;text-wrap:balance}
.kindtag{color:#fff;padding:4px 12px;font:600 17px var(--pix);border:2px solid #000;text-shadow:2px 2px 0 rgba(0,0,0,.5)}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:-10px}
.chip{background:#000;color:var(--gold);border:2px solid #555;padding:6px 14px;font-size:17px}
.btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btns.left{justify-content:flex-start}

.editor{padding:24px 26px;display:flex;flex-direction:column;gap:14px}
.editor .row-label{color:var(--panel-ink);text-shadow:none}
.editor .hint{color:#555;text-shadow:none}
.edhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.status{font-size:17px;color:#24561A}
#msg{width:100%;min-height:220px;resize:vertical;font:21px/1.3 var(--mono);padding:14px 16px;overflow:hidden}
.hist summary{font:600 22px var(--pix);cursor:pointer;padding:6px 0}
.hist ol{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
.hist li{display:flex;justify-content:space-between;align-items:center;gap:14px;background:#8B8B8B;color:#fff;text-shadow:2px 2px 0 #3F3F3F;padding:10px 14px;min-width:0;
  box-shadow:inset 3px 3px 0 #373737,inset -3px -3px 0 #fff}
.hist li > div{min-width:0}
.hist li.now{outline:3px solid #24561A;outline-offset:-3px}
.hist .when,.hist .what{color:#EDEDED;font-size:17px;word-break:break-word}
.pill{flex:none;background:var(--ok);color:#fff;border:2px solid #000;padding:3px 10px;font-size:15px}
.tile.resume{min-height:120px;gap:8px}
.tile.resume .kindtag{font-size:14px}

/* title-screen panorama behind every screen; darker away from the title screen */
#pano{position:fixed;inset:-40px;z-index:-1;background-repeat:no-repeat;background-size:cover;background-position:50% 45%;filter:blur(6px) brightness(.6) saturate(1.05);animation:drift 60s ease-in-out infinite alternate}
body.home #pano{filter:none;inset:0;animation:none;background-position:50% 60%}
body.home::after{content:"";position:fixed;inset:auto 0 0 0;height:22dvh;z-index:-1;background:linear-gradient(transparent,rgba(0,0,0,.45));pointer-events:none}
.logo .logoimg{display:block;width:min(86vw,780px,62dvh * 5.6);width:min(86vw,780px,calc(17dvh * 5.6));height:auto;filter:drop-shadow(0 6px 10px rgba(0,0,0,.35));-webkit-user-select:none;user-select:none}
body.home .logo .badge{top:auto;bottom:-6%;right:-3%}
@keyframes drift{from{transform:scale(1.05) translate(-1.5%,-1%)}to{transform:scale(1.15) translate(1.5%,1%)}}
body{background:#4E7A35}
.title-screen{min-height:calc(100vh - 62px);display:flex;flex-direction:column;align-items:center;gap:22px;position:relative;padding-top:24px}
.corner{position:absolute;top:0;right:0}
.logo{position:relative;text-align:center;margin-top:clamp(28px,9vh,110px)}
.logo .l1,.logo .l2{font-family:var(--head);font-weight:400;color:#E4E4E4;line-height:.9;letter-spacing:.04em;
  text-shadow:0 2px 0 #A0A0A0,0 4px 0 #8A8A8A,0 6px 0 #6E6E6E,0 8px 0 #555,0 10px 0 #3A3A3A,0 12px 0 #222,
    -3px 0 0 #000,3px 0 0 #000,0 -3px 0 #000,0 14px 0 #000,-3px 12px 0 #000,3px 12px 0 #000}
.logo .l1{font-size:clamp(30px,4.5vw,52px)}
.logo .l2{font-size:clamp(40px,8vw,96px);text-transform:uppercase}
.logo .lw{position:relative;display:inline-block}
.logo .badge{position:absolute;top:0;right:0;transform:rotate(6deg);font-family:var(--head);font-weight:400;
  font-size:clamp(18px,2.6vw,30px);line-height:1;text-transform:uppercase;letter-spacing:.04em;color:#2B1F16;
  background:#F2C230;border:3px solid #000;box-shadow:inset 0 -3px 0 #B8891A,inset 0 3px 0 #FFE07A,3px 3px 0 rgba(0,0,0,.5);
  padding:.35em .55em .3em;white-space:nowrap;pointer-events:none}
.splash{position:absolute;right:-6%;bottom:-6px;color:#FFFF00;font:600 clamp(18px,2.4vw,28px) var(--pix);text-shadow:3px 3px 0 #3F3F00;transform:rotate(-17deg);white-space:nowrap;animation:splash .5s ease-in-out infinite alternate;transform-origin:center}
@keyframes splash{from{transform:rotate(-17deg) scale(.94)}to{transform:rotate(-17deg) scale(1.06)}}
.today{max-width:520px;text-align:center;font-size:19px;line-height:1.35;color:#fff;background:rgba(0,0,0,.55);border:2px solid #000;padding:12px 16px;text-shadow:2px 2px 0 #000}
.ask{font-size:clamp(20px,2.4vw,26px);color:#fff;text-shadow:2px 2px 0 #000;text-align:center;margin-top:auto}
.menu{width:min(520px,100%);display:flex;flex-direction:column;gap:12px;margin-top:auto}
.tile.mm{min-height:62px;padding:10px 16px;font-size:26px;width:100%;flex-direction:row}
.tile.mm.primary{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A}
.tile.mm[disabled]{opacity:.5;cursor:default;outline:none}
.menu-row{display:flex;gap:12px}
.tile.mm.half{font-size:20px}
.savedlist{display:flex;flex-direction:column;gap:8px}
.tile.mm.resume{font-size:19px;justify-content:flex-start;gap:10px;min-height:52px}
.tile.mm.resume small{margin-left:auto}
.foot{margin-top:4px;width:100%;display:flex;justify-content:space-between;gap:12px;font-size:17px;color:#fff;text-shadow:2px 2px 0 #000;padding-top:30px}
@media (max-width:640px){ .splash{right:4px;bottom:-22px} .title-screen{padding-top:56px} .tile.mm{font-size:22px} .menu-row{flex-direction:column} }
@media (prefers-reduced-motion:reduce){#pano,.splash{animation:none!important}}
/* universal picker */
.trail{font-size:18px;color:var(--gold);text-shadow:2px 2px 0 #000;margin:0 0 10px;letter-spacing:.02em}
.partno{font:600 18px var(--pix);color:var(--gold);text-shadow:2px 2px 0 #000;background:rgba(0,0,0,.45);padding:6px 12px;border:2px solid #000}
.soFar{background:var(--panel);color:var(--panel-ink);border:3px solid #000;box-shadow:inset 4px 4px 0 var(--panel-hi),inset -4px -4px 0 var(--panel-lo);padding:18px 22px}
.soFar span{font:600 18px var(--pix);color:#555}
.soFar p{font:600 26px/1.3 var(--pix);margin:6px 0 0}
.grid.big2{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.grid.big2 .tile{min-height:170px;font-size:32px}
.tile.folder{background:#5E5E5E;box-shadow:inset 3px 3px 0 #8E8E8E,inset -3px -4px 0 #383838}
.tile.folder::before{content:"";position:absolute;right:10px;bottom:10px;border:7px solid transparent;border-left:9px solid #fff;filter:drop-shadow(2px 2px 0 #000)}
.tile.primary{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A}
.tile[disabled]{opacity:.4;cursor:default;outline:none}
/* number builder */
.numbox{gap:12px;padding:22px}
.bignum{font:700 clamp(64px,9vw,104px)/1 "Silkscreen",var(--pix);color:#3F3F3F}
.sumline{font:600 30px var(--mono);color:#24561A;min-height:32px}
.numwhat{font:600 22px var(--pix);margin:0}
.numsay{font:600 20px var(--pix);margin:0;color:#3F3F3F}
.blocks{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:flex-end;max-width:100%}
.blocks i{display:inline-block;width:16px;height:16px;background:#8B5A2B;border:2px solid #000;box-shadow:inset 2px 2px 0 #C08550,inset -2px -2px 0 #4F3016}
.blocks i.half{width:8px}
.stack{width:52px;height:52px;display:grid;place-items:center;background:#8B5A2B;border:3px solid #000;box-shadow:inset 3px 3px 0 #C08550,inset -3px -3px 0 #4F3016;color:#fff;font:600 18px var(--pix);text-shadow:2px 2px 0 #000}
.eights{display:flex;flex-direction:column;gap:3px}.row8{display:flex;gap:3px}
.coinbag{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#D4A017;border:3px solid #000;color:#fff;font:600 16px var(--pix);text-shadow:2px 2px 0 #000}
.c1{display:inline-block;width:20px;height:20px;border-radius:50%;background:#E8C547;border:2px solid #000}
.c1.half{width:10px;border-radius:10px 0 0 10px}
.stackmore{font:600 18px var(--pix);color:#3F3F3F}
.timesrow .one{font:600 18px var(--pix);width:26px;height:26px;display:grid;place-items:center;background:#7A7A7A;color:#fff;border:2px solid #000}
.timesrow .arrow{font-size:22px;color:#3F3F3F}
.grid.ops{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.grid.ops .tile{min-height:76px;font-size:22px}
/* puzzle + stats */
.puz{max-width:760px;width:100%;align-self:center;box-sizing:border-box}
.puzq{font:600 26px/1.3 var(--pix);margin:0}
.grid.puzopts{width:100%;grid-template-columns:repeat(3,1fr)}
.tile.mm.right{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A;opacity:1}
.puzopts .tile[disabled]{opacity:1}
.done .puz p,.puz h2{color:var(--panel-ink);text-shadow:none;max-width:none}
.go#numdone{background:var(--ok);box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A}
.puzres{font:600 24px var(--pix);margin:0;color:#24561A}
.stats{background:rgba(0,0,0,.55);border:2px solid #000;padding:10px 14px;display:flex;flex-direction:column;gap:6px}
.srow{display:flex;align-items:center;gap:10px;font-size:17px;text-shadow:2px 2px 0 #000}
.slab{width:150px}.sbar{display:flex;gap:3px;flex:1}.sbar i{width:14px;height:14px;border:2px solid #000}
.fixtag{background:var(--ok);color:#fff;border:2px solid #000;padding:2px 8px;font-size:14px;margin-left:8px}
.fixtag.wip{background:var(--better)}
.relnotes{margin:0;padding-left:22px;font-size:19px;text-shadow:2px 2px 0 #000}
.relhow{margin:0;font-size:16px;color:#fff;text-shadow:2px 2px 0 #000}
.relpanel .tile{box-sizing:border-box}
.tile.mm.latestver{font-size:20px;min-height:52px}
.tile.mm.newver{background:#B8860B;box-shadow:inset 3px 3px 0 #E2B23D,inset -3px -4px 0 #6E5006}
.relpanel{background:rgba(0,0,0,.55);border:2px solid #000;padding:12px}
/* home screen: exactly one screen, never scrolls; lists open as overlays */
html:has(body.home),body.home{height:100%;overflow:hidden;overscroll-behavior:none}
body.home{padding-top:0!important}
body.home .app{height:100dvh;min-height:0;box-sizing:border-box;overflow:hidden;padding-block:max(10px,env(safe-area-inset-top,0px)) max(10px,env(safe-area-inset-bottom,0px));gap:0}
body.home .title-screen{height:100%;min-height:0;padding-top:0;gap:clamp(8px,2dvh,22px)}
body.home .logo{margin-top:clamp(6px,7dvh,110px)}
body.home .foot{padding-top:0}
.homeover{position:fixed;inset:0;z-index:15;background:rgba(0,0,0,.6);display:grid;place-items:center;padding:16px}
.homeover .inner{width:min(560px,100%);max-height:84dvh;overflow:auto;box-sizing:border-box;background:#2B2B2B;border:3px solid #000;padding:14px;display:flex;flex-direction:column;gap:10px;-webkit-overflow-scrolling:touch}
.tile.mm.closeover{background:#4E4E4E;box-shadow:inset 3px 3px 0 #777,inset -3px -4px 0 #2A2A2A;flex:none}
body.home .logo .l1{font-size:min(6vw,7dvh,64px)}
body.home .logo .l2{font-size:min(11vw,13dvh,124px)}
body.home .tile.mm{min-height:clamp(44px,7.4dvh,62px);padding-block:6px}
body.home .menu{gap:clamp(6px,1.4dvh,12px)}
body.home .ask{font-size:min(2.4vw,3.2dvh,26px)}
body.home .today{font-size:min(17px,2.4dvh);padding:6px 12px}
body.home .foot{font-size:min(17px,2.2dvh)}
@media (max-height:700px){ body.home .logo .l2{font-size:clamp(34px,6vw,72px)} body.home .tile.mm{min-height:50px;font-size:22px} body.home .today{font-size:16px;padding:8px 12px} }
.rcard{display:flex;align-items:center;gap:12px;width:100%;text-align:left;font-family:var(--pix);color:#fff;background:var(--stone);border:3px solid #000;box-shadow:inset 3px 3px 0 var(--stone-hi),inset -3px -4px 0 var(--stone-lo);padding:10px 12px;cursor:pointer;text-shadow:2px 2px 0 var(--shade)}
.rkind{flex:none;width:18px;align-self:stretch;border:2px solid #000}
.rwhat{flex:1;min-width:0;display:flex;flex-direction:column}
.rwhat b{font-size:21px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rwhat small{font-size:15px;color:#E0E0E0}
.rstate{flex:none;font-size:16px;padding:6px 10px;border:2px solid #000;max-width:45%;text-align:center}
.st-draft{background:#4E4E4E}.st-sent{background:var(--idea)}.st-wip{background:var(--better)}.st-fixed{background:var(--ok)}
.q h1,.logo{-webkit-touch-callout:none}
@media (max-height:480px){ body.home .ask,body.home .logo .l1{display:none} body.home .tile.mm{min-height:38px;font-size:18px} }
/* home layout: logo near the top, question + buttons centred in the space below, one centred footer line */
body.home .title-screen{justify-content:flex-start}
/* logo sits exactly where the title is painted in the key art (bg cover, 50% 60%; title centre at y=197 of 941, png 937 wide x 154 tall) */
body.home{--u:max(calc(100vw / 1672),calc(100dvh / 941));--lw:min(calc(var(--u) * 937),82vw)}
body.home .logo .logoimg{width:var(--lw)}
body.home .app{max-width:none}
body.home .logo{margin-top:max(0px,calc((100dvh - var(--u) * 941) * .6 + var(--u) * 197 - var(--lw) * .0822 - max(10px,env(safe-area-inset-top,0px))))}
body.home .ask{margin-top:auto;margin-bottom:clamp(2px,0.6dvh,8px)}
body.home .menu{margin-top:auto;margin-bottom:auto;position:relative;top:clamp(24px,6.5dvh,80px)}
body.home .today{margin-top:auto;margin-bottom:clamp(6px,1.4dvh,12px)}
body.home .today + .menu{margin-top:0}
body.home .foot{justify-content:center;gap:12px;padding-bottom:clamp(6px,1.6dvh,18px);opacity:.85}
body.home .menu > .lastkind{margin-bottom:clamp(10px,3.2dvh,34px)}
body.home .menu > .menurow{margin-bottom:clamp(10px,3.2dvh,34px)}
/* home buttons: closer to the real title screen. Flat grey stone, thin black border, 2px bevel, light text with a hard shadow */
body.home .menu .tile.mm,body.home .player .tile.mm{background:#6F6F6F linear-gradient(180deg,rgba(255,255,255,.06),rgba(0,0,0,.06));border:2px solid #000;
  box-shadow:inset 2px 2px 0 #A6A6A6,inset -2px -3px 0 #4A4A4A;color:#EDEDED;text-shadow:2px 2px 0 #383838;font-weight:500;letter-spacing:.02em}
body.home .menu .tile.mm:hover,body.home .player .tile.mm:hover{outline:2px solid #fff;outline-offset:-2px}
body.home .menu .tile.mm:active,body.home .player .tile.mm:active{background:#5E5E5E;box-shadow:inset 2px 2px 0 #4A4A4A,inset -2px -2px 0 #8A8A8A}
body.home .menu .tile.mm.latestver,body.home .menu .tile.mm.newver{font-size:min(26px,3.4vw);min-height:clamp(44px,7.4dvh,62px)}
body.home .menu .menurow .tile.mm{font-size:min(20px,2.6vw)}
body.home .menu > .tile.mm{font-size:min(26px,3.4vw)}
.vtag{position:absolute;top:-14px;right:-12px;font:500 17px/1 var(--pix);color:#fff;text-shadow:2px 2px 0 #1E5A12;background:#4CC23A;border:2px solid #1E5A12;
  box-shadow:inset 2px 2px 0 #7EE06A,inset -2px -2px 0 #2E8A22;padding:4px 7px;transform:rotate(-4deg);pointer-events:none}
.vtag::after{content:"";position:absolute;left:8px;bottom:-9px;border:5px solid transparent;border-top:6px solid #1E5A12;border-left:6px solid #1E5A12}
/* lists: drafts, previous requests, follow-ups */
.listlabel{font:400 34px/1 var(--head);letter-spacing:.02em;color:#fff;text-shadow:3px 3px 0 #000}
.menurow{display:flex;gap:inherit;width:100%}
.menurow .tile.mm{flex:1;min-width:0;padding-inline:6px;white-space:nowrap;font-size:min(20px,2.6vw)}
.rrow{display:flex;flex-direction:column;gap:4px}
.tile.mm.fbbtn{min-height:44px;font-size:18px;background:#7A4A12;box-shadow:inset 3px 3px 0 #A86A24,inset -3px -4px 0 #4A2C08}
.fbmsg{width:100%;box-sizing:border-box;font:500 20px var(--pix);padding:10px 12px;border:3px solid #000;background:#F4F4F4;color:#222;resize:none}
/* iOS share sheet and Messages stay iOS-looking: they are the iPad's own screens */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center;z-index:20;font-family:-apple-system,system-ui,sans-serif;text-shadow:none}
.sheet{width:min(560px,100%);background:#F2F2F7;color:#111;border-radius:22px 22px 0 0;padding:18px 20px calc(24px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:16px}
.sheet .grab{width:44px;height:5px;border-radius:3px;background:#C7C7CC;align-self:center}
.sheet .prev{display:flex;gap:12px;align-items:center;font-size:15px;color:#6B6B70;border-bottom:1px solid #D1D1D6;padding-bottom:12px}
.sheet .prev b{color:#111;display:block;font-size:16px}
.sheet .prev img{width:56px;height:42px;object-fit:cover;border-radius:6px}
.people,.apps{display:flex;gap:18px;overflow-x:auto}
.person,.appi{display:flex;flex-direction:column;align-items:center;gap:6px;font:13px -apple-system,system-ui,sans-serif;background:none;border:none;color:#111;cursor:pointer;min-width:72px}
.av{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;font:600 24px -apple-system,system-ui,sans-serif;color:#fff;background:#8E9AA6}
.ai{width:60px;height:60px;border-radius:14px}
.imsg{width:min(620px,100%);height:min(86vh,720px);background:#fff;color:#111;border-radius:22px;display:flex;flex-direction:column;overflow:hidden;align-self:center}
.imsg header{padding:14px;text-align:center;border-bottom:1px solid #E5E5EA;font-weight:600}
.imsg .body{flex:1;overflow:auto;padding:16px;display:flex;flex-direction:column;justify-content:flex-end;gap:6px}
.imsg .photo{align-self:flex-end;max-width:60%;border-radius:18px;display:block}
.bubble{align-self:flex-end;max-width:88%;background:#1A84FF;color:#fff;border-radius:20px 20px 4px 20px;padding:12px 14px;font:13px/1.45 ui-monospace,Menlo,monospace;white-space:pre-wrap;user-select:text;-webkit-user-select:text}
.imsg footer{display:flex;gap:10px;padding:12px;border-top:1px solid #E5E5EA;align-items:center}
.imsg footer span{flex:1;color:#8E8E93;font-size:14px}
.sendb{width:52px;height:52px;border-radius:50%;border:none;background:#1A84FF;color:#fff;font-size:26px;cursor:pointer;display:grid;place-items:center}
.note{font-size:15px;color:var(--muted);text-align:center}
.sheet .note{color:#6B6B70}

/* done: game-style "toast" */
.done{display:flex;flex-direction:column;align-items:center;gap:22px;text-align:center;padding-top:30px}
.toast{background:#212121;border:3px solid #000;box-shadow:inset 3px 3px 0 #555,inset -3px -3px 0 #111;padding:20px 28px;display:flex;gap:18px;align-items:center;text-align:left;max-width:560px}
.toast .ic{flex:none;width:72px;height:72px;background:var(--ok);border:3px solid #000;box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -3px 0 #24561A;display:grid;place-items:center;font-size:40px;color:#fff}
.toast b{display:block;color:var(--gold);font-size:22px;text-shadow:2px 2px 0 #3F3F15}
.toast span{font-size:26px;text-shadow:2px 2px 0 #000}
.done p{font-size:22px;color:var(--muted);margin:0;max-width:34ch;text-shadow:2px 2px 0 #000}

/* grown-up drawer */
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100%);background:var(--panel);color:var(--panel-ink);border-left:3px solid #000;z-index:30;text-shadow:none;
  display:flex;flex-direction:column;padding:calc(16px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(16px + env(safe-area-inset-bottom,0px)) 18px;gap:12px;box-shadow:inset 4px 0 0 #fff}
.drawer h3{margin:0;font:600 24px var(--pix);display:flex;justify-content:space-between;align-items:center}
.drawer p{margin:0;font-size:17px;color:#555;line-height:1.3}
.drawer pre{flex:1;overflow:auto;margin:0;background:#000;color:#fff;border:3px solid #A0A0A0;padding:14px;font:19px/1.3 var(--mono);white-space:pre-wrap;user-select:text;-webkit-user-select:text;min-width:0}
.drawer .x{border:none;background:none;font-size:26px;cursor:pointer;color:var(--panel-ink);display:grid}
.copy{font:600 20px var(--pix);padding:10px;cursor:pointer;color:#fff;text-shadow:2px 2px 0 #3F3F3F;border:3px solid #000;background:var(--stone);box-shadow:inset 3px 3px 0 var(--stone-hi),inset -3px -4px 0 var(--stone-lo)}

@media (max-width:640px){
  body{font-size:17px}
  .app{gap:18px;padding-block:14px 28px}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .tile{min-height:92px;font-size:20px;padding:14px 8px}
  .tile.horse{min-height:116px}
  .grid.big{grid-template-columns:1fr}
  .grid.big .tile{min-height:120px;font-size:30px}
  .round{width:50px;height:50px;font-size:22px}
  .grown{padding:6px 10px;font-size:13px}
  .go{min-width:0;font-size:24px;padding:14px 30px}
  .story,.editor,.namebox{padding:20px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* step pages: roomier layout, labelled Back button */
body:not(.home) .app{max-width:1000px;min-height:100dvh;box-sizing:border-box;justify-content:center;padding-bottom:max(env(safe-area-inset-bottom,0px),clamp(40px,8dvh,110px));gap:clamp(22px,3.4dvh,40px);padding-top:max(env(safe-area-inset-top,0px),clamp(28px,5dvh,64px))}
body:not(.home) .bar{min-height:56px}
.backbtn{width:auto;height:56px;display:inline-flex;align-items:center;gap:10px;padding:0 22px 0 16px;font-size:22px}
.backbtn svg{width:24px;height:24px}
body:not(.home) .q{padding-bottom:clamp(4px,1dvh,14px);border-bottom:3px solid rgba(0,0,0,.35);box-shadow:0 3px 0 rgba(255,255,255,.12)}
body:not(.home) .q > div{padding-bottom:clamp(12px,2dvh,22px)}
body:not(.home) .grid{gap:clamp(14px,2.2vw,22px)}
body:not(.home) .grid .tile{min-height:clamp(110px,14dvh,170px)}

/* split download row + all-versions list */
body.home .menu > .menurow.relrow{margin-bottom:0}
body.home .menu .relrow .tile.mm{font-size:min(20px,2.6vw)}
.homeover .inner.prevpanel{width:min(1160px,100%);height:min(92dvh,1000px);max-height:none;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);grid-template-rows:minmax(0,1fr) auto;gap:14px 18px;padding:18px;overflow:hidden}
.prevcol{display:flex;flex-direction:column;gap:10px;overflow:auto;min-height:0;-webkit-overflow-scrolling:touch;padding-right:4px}
.prevclose{grid-column:1 / -1}
.prevpanel .listlabel{font-size:34px}
.relfixes{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px;font-size:17px}
.relfixes small{color:#cfcfcf;font-size:14px}
.fbh{display:inline-block;background:var(--gold);color:#2a2205;border:2px solid #000;font-size:13px;padding:1px 7px;margin-right:6px}
.repcard{display:flex;align-items:center;gap:12px;background:#1f1f1f;border:2px solid #000;box-shadow:inset 2px 2px 0 #444;padding:10px 12px}
.repcard .rt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.repcard .rt b{font-size:19px;font-weight:500;text-shadow:2px 2px 0 #000}
.repcard .rt small{font-size:14px;color:#cfcfcf}
.repcard .rkind{flex:none}
@media (max-aspect-ratio:1/1){ .homeover .inner.prevpanel{grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1.3fr) minmax(0,1fr) auto} }
.relcard{background:#1f1f1f;border:2px solid #000;box-shadow:inset 2px 2px 0 #444;padding:12px 14px;display:flex;flex-direction:column;gap:8px}
.relhead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.relhead b{font:400 30px/1 var(--head);text-shadow:2px 2px 0 #000}
.relhead span{font-size:15px;color:#cfcfcf}
.relhead .vtag2{font-size:13px;color:#fff;background:#3f8f2d;border:2px solid #000;padding:2px 8px}
.relhead .vtag2.have{background:#B8860B}
.relfixed{margin:0;font-size:15px;color:var(--gold);text-shadow:2px 2px 0 #000}
.tile.mm.relget{text-decoration:none;min-height:48px;font-size:19px;box-sizing:border-box;width:100%;align-self:stretch}

/* report tracker */
.homeover .inner.trackpanel{width:min(720px,100%);gap:14px;padding:18px}
.trkhead{display:flex;gap:12px;align-items:stretch}
.trkhead .rkind{width:18px}
.trkhead small{font-size:15px;color:#cfcfcf}
.trackpanel .listlabel{font-size:32px}
.trkwords{margin:0;font-size:18px;color:#e9e9e9;background:#1f1f1f;border:2px solid #000;padding:10px 12px}
.timeline{list-style:none;margin:0;padding:4px 0 0 0;display:flex;flex-direction:column}
.tl{display:flex;gap:14px;position:relative;padding:0 0 16px 0}
.tl::before{content:"";position:absolute;left:10px;top:22px;bottom:0;width:4px;background:#555}
.tl:last-child::before{display:none}
.tl.tl-done::before{background:var(--ok)}
.tdot{flex:none;width:24px;height:24px;border:3px solid #000;background:#555;box-sizing:border-box;margin-top:1px}
.tl.tl-done .tdot{background:var(--ok)}
.tl.tl-now .tdot{background:var(--gold)}
.tl b{display:block;font-size:20px;font-weight:500;text-shadow:2px 2px 0 #000}
.tl small{display:block;font-size:15px;color:#cfcfcf;margin-top:2px}
.tl.tl-next b{color:#bdbdbd}
.relhow.big{font-size:20px}
.row2{display:flex;gap:10px}.row2 > *{flex:1;min-width:0}
.homeover .trackpanel .tile.mm.okbtn{background:var(--ok)!important;box-shadow:inset 3px 3px 0 #6FC25A,inset -3px -4px 0 #24561A!important}
.trackpanel .row2 .tile.mm{font-size:20px;min-height:56px}
.homeover .trackpanel .tile.mm.fbbtn{background:#7A4A12!important;box-shadow:inset 3px 3px 0 #A86A24,inset -3px -4px 0 #4A2C08!important}
.tl > div{text-align:left}
.repcard[data-track]{cursor:pointer}

/* lock screen (device pairing) */
.lockscreen .lockpanel{width:min(560px,100%);margin:auto auto;box-sizing:border-box;background:rgba(30,30,30,.88);border:3px solid #000;box-shadow:inset 3px 3px 0 #555,inset -3px -3px 0 #191919;padding:18px;display:flex;flex-direction:column;gap:12px}
.lockscreen .lockpanel .listlabel{font-size:32px}
.lockpanel .row2 .tile.mm{flex:1 1 0;min-height:52px;font-size:20px}
.paircode{font:500 22px var(--pix);padding:12px 14px;background:#111;color:#fff;border:3px solid #000;box-shadow:inset 2px 2px 0 #333;width:100%;box-sizing:border-box}

.relhead .uname{font:400 26px/1 var(--head);color:var(--gold);text-shadow:2px 2px 0 #000}
.relhead.small b{font-size:22px}
.relcard details summary{cursor:pointer;list-style:none;font-size:17px;padding:10px 12px;background:#3a3a3a;border:2px solid #000;box-shadow:inset 2px 2px 0 #555,inset -2px -2px 0 #222}
.relcard details summary::-webkit-details-marker{display:none}
.relcard details summary::before{content:"+ "}
.relcard details[open] summary::before{content:"- "}
.relvers{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.relver{border-left:4px solid #555;padding:4px 0 4px 12px;display:flex;flex-direction:column;gap:6px}
.relver .relnotes{font-size:17px}

/* mod features gallery */
.homeover .inner.featpanel{width:min(1100px,100%);max-height:92dvh;gap:14px;padding:18px}
.herowrap{position:relative}
.heroimg{display:block;width:100%;aspect-ratio:16/8;max-height:44dvh;background-size:cover;background-position:center;border:3px solid #000;cursor:pointer;position:relative;padding:0}
.herocap{position:absolute;left:0;right:0;bottom:0;padding:40px 18px 14px;background:linear-gradient(transparent,rgba(0,0,0,.8));text-align:left;display:flex;flex-direction:column;gap:4px;color:#fff;font-family:var(--pix)}
.herocap b{font:400 clamp(30px,4vw,44px)/1 var(--head);text-shadow:3px 3px 0 #000}
.herocap small{font-size:18px;text-shadow:2px 2px 0 #000}
.heroarrow{position:absolute;top:50%;transform:translateY(-50%);width:52px;height:64px;font:400 40px/1 var(--pix);color:#fff;background:rgba(0,0,0,.55);border:3px solid #000;cursor:pointer}
.heroarrow.l{left:10px}.heroarrow.r{right:10px}
.herodots{display:flex;gap:6px;justify-content:center}
.herodots span{width:12px;height:12px;background:#555;border:2px solid #000}
.herodots span.on{background:var(--gold)}
.featgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.feattile{display:flex;flex-direction:column;gap:4px;text-align:left;background:#1f1f1f;border:3px solid #000;box-shadow:inset 2px 2px 0 #444;padding:0 0 10px;cursor:pointer;color:#fff;font-family:var(--pix)}
.feattile img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;border-bottom:3px solid #000;margin-bottom:6px}
.feattile b{font-size:19px;font-weight:500;padding:0 10px;text-shadow:2px 2px 0 #000}
.feattile small{font-size:14px;color:#cfcfcf;padding:0 10px}
.feattile:hover{outline:3px solid #fff;outline-offset:-6px}
.feathero{width:100%;aspect-ratio:16/9;object-fit:cover;border:3px solid #000;display:block}
.featbody{display:flex;flex-direction:column;gap:10px}
.featdetail .relhead b{font:400 38px/1 var(--head)}
.featdetail .relnotes{font-size:20px}
.featdetail .row2 .tile.mm{min-height:56px;font-size:19px}

/* home order: Download latest, gap, then two split rows */
body.home .menu > .relmain{margin-bottom:clamp(12px,3.4dvh,36px)}
body.home .menu > .menurow{margin-bottom:0}
body.home .menu .menurow .tile.mm{font-size:min(20px,2.6vw)}

/* home-screen player (skin maker) */
body:not(.home) .player{display:none}
.player{position:absolute;left:calc(100% + clamp(24px,5vw,110px));bottom:0;display:flex;flex-direction:column;align-items:center;gap:clamp(6px,1.2dvh,14px);z-index:2;--px:clamp(5px,.88dvh,12px)}
.player .nametag{margin-bottom:calc(var(--px)*3.6);font-family:var(--pix);color:#fff;background:rgba(40,52,74,.78);padding:2px 12px 3px;font-size:clamp(16px,2.2vw,28px);line-height:1.2;letter-spacing:.5px}
.pstage{width:calc(var(--px)*16);height:calc(var(--px)*33);perspective:calc(var(--px)*160);filter:drop-shadow(0 calc(var(--px)*1) calc(var(--px)*1.5) rgba(0,0,0,.45))}
.pfig{position:relative;width:100%;height:100%;transform-style:preserve-3d;transform:rotateX(-6deg) rotateY(-28deg);animation:pidle 7s ease-in-out infinite}
@keyframes pidle{0%,100%{transform:rotateX(-6deg) rotateY(-28deg)}50%{transform:rotateX(-6deg) rotateY(-16deg)}}
.pb{position:absolute;transform-style:preserve-3d}
.pf{position:absolute;left:0;top:0;background-image:var(--skin);background-size:calc(var(--px)*64) calc(var(--px)*64);image-rendering:pixelated;image-rendering:crisp-edges;backface-visibility:hidden}
.pf.right,.pf.left,.pf.back{filter:brightness(.78)}.pf.top{filter:brightness(1.08)}.pf.bottom{filter:brightness(.6)}
.phead{transform-origin:50% 100%;animation:plook 5s ease-in-out infinite}
@keyframes plook{0%,100%{transform:rotateY(0) rotateX(0)}30%{transform:rotateY(14deg) rotateX(-4deg)}65%{transform:rotateY(-10deg) rotateX(3deg)}}
.parm{transform-origin:50% calc(var(--px)*2)}
.parm.r{animation:pswing 4s ease-in-out infinite}.parm.l{animation:pswing 4s ease-in-out infinite reverse}
@keyframes pswing{0%,100%{transform:rotateX(4deg) rotateZ(2deg)}50%{transform:rotateX(-4deg) rotateZ(1deg)}}
.parm.l{animation-name:pswingl}@keyframes pswingl{0%,100%{transform:rotateX(-4deg) rotateZ(-2deg)}50%{transform:rotateX(4deg) rotateZ(-1deg)}}
body.home .player .tile.mm.skinbtn{display:flex;align-items:center;justify-content:center;text-decoration:none;color:#fff;font-size:min(20px,2.6vw);min-width:calc(var(--px)*19);min-height:clamp(40px,6.4dvh,56px);padding:0 16px;box-sizing:border-box;white-space:nowrap}
@media (prefers-reduced-motion:reduce){.pfig,.phead,.parm{animation:none!important}}
/* portrait: the menu fills the middle, so the player sits lower and smaller */
@media (max-aspect-ratio:1/1){.player{left:auto;right:0;bottom:calc(100% + clamp(10px,2dvh,28px));--px:clamp(4px,.52dvh,8px)}}

.typeit{display:flex;justify-content:center;margin-top:clamp(10px,2.4dvh,26px)}
.typeit .go{font-size:18px}
.freebox textarea{min-height:clamp(140px,26dvh,260px)}

.paircode{letter-spacing:.5em;text-align:center;font-size:28px}
</style>

<div class="app" id="app"></div>
<div id="layer"></div>


